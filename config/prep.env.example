# disconnected-prep configuration
#
# Copy to config/prep.env and edit. Every script in scripts/ sources this file.
#
# QUAY_PASSWORD below is a real credential, so the copy you create is one
# too -- mode it accordingly and keep it out of any bundle that crosses
# the airgap:
#
#   cp config/prep.env.example config/prep.env
#   chmod 600 config/prep.env
#   ${EDITOR} config/prep.env

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Root of the prep tree. Same relative layout on both hosts, but the two are
# configured separately and do not have to use the same path.
#
# On a STIG build /home is its own file system, sized for user files and
# often quota'd. Provision 500 GB on the registry host and 300-500 GB on the
# connected bastion -- both grow monotonically and neither reclaims space on
# its own, and a real content set (several operators, ACM/ACS, guest images,
# more than one retained version) gets there quickly. See
# docs/10-capacity-planning.md. Put this on the volume you provisioned for
# it: OCP_AIRGAP_ROOT="/data/ocp-airgap".
#
# Everything below derives from it, so this one line moves the whole tree.
# An exported OCP_AIRGAP_ROOT wins, so the value the docs have you export
# by hand and the value the scripts use are the same variable.
OCP_AIRGAP_ROOT="${OCP_AIRGAP_ROOT:-${HOME}/ocp-airgap}"

# oc-mirror's layer cache. MUST be on a partition with plenty of free space:
# this grows to roughly the full uncompressed size of everything you mirror.
# oc-mirror stores data at ${CACHE_DIR}/.oc-mirror/.cache
# If unset, oc-mirror defaults to $HOME, which on a STIG'd box is often a
# small partition. Always set it explicitly.
CACHE_DIR="${OCP_AIRGAP_ROOT}/cache"

# Persistent mirror-to-disk destination (connected bastion).
# Do NOT use a new directory per run -- the incremental history that makes
# Day-2 deltas cheap lives in ${MIRROR_OUT}/working-dir/.history/.
# See docs/09-day2-delta.md.
MIRROR_OUT="${OCP_AIRGAP_ROOT}/mirror-out"

# Per-run transport staging. Archives are COPIED here after each run so a
# dated, immutable bundle exists for transfer and for your records.
EXPORTS_DIR="${OCP_AIRGAP_ROOT}/exports"

# Landing directory for incoming archives (registry host).
IMPORTS_DIR="${OCP_AIRGAP_ROOT}/imports"

# Tag identifying this mirroring run. Used as the export/import subdirectory.
# Convention: YYYY-MM-DD_purpose
EXPORT_TAG="2026-10-02_initial"

# ---------------------------------------------------------------------------
# OpenShift content
# ---------------------------------------------------------------------------

# Exact z-stream you intend to install. Pin it; do not use a floating channel.
OCP_VERSION="4.21.34"

# Update channel the version above lives in.
OCP_CHANNEL="stable-4.21"

# Cluster architecture. amd64 | arm64 | ppc64le | s390x
# Mirroring multiple architectures multiplies payload size.
OCP_ARCH="amd64"

# The same architecture as named in release image TAGS, which uses the
# GNU-style name rather than the Go-style one. These differ and the mismatch
# is a common source of "manifest unknown" errors:
#   amd64 -> x86_64     arm64 -> aarch64
#   ppc64le -> ppc64le  s390x -> s390x
RELEASE_ARCH="x86_64"

# The composed ImageSetConfiguration used for this environment.
# Build it with: ./scripts/12-compose-imageset.sh   (docs/02-plan-your-content.md)
IMAGESET_CONFIG="${OCP_AIRGAP_ROOT}/config/imageset-config.yaml"

# ---------------------------------------------------------------------------
# Mirror registry
# ---------------------------------------------------------------------------

# Registry hostname. MUST be resolvable by the cluster nodes, not just the
# registry host -- this ends up in IDMS/ITMS and in install-config.yaml.
# Do not use "localhost" or a bare hostname with no dot.
REGISTRY_HOST="registry.airgap.local"
REGISTRY_PORT="8443"

# Quay CONFIG root (certs + config.yaml). This is NOT where images go --
# measured at ~32 KB on a real install. Needs durability, not capacity.
#
# Image data goes to podman's volume store, usually under $HOME:
#   podman info --format '{{.Store.GraphRoot}}'
# Provision 500 GB on THAT filesystem, and relocate it before installing if
# it is on a small root volume. See docs/05-registry.md.
QUAY_ROOT="/opt/quay"

# UID Quay runs as INSIDE its container. Rootless podman maps it to
# ${subuid_base} + QUAY_CONTAINER_UID - 1 on the host, and that is the UID
# granted read access to quay-config and quay-rootCA -- without it Quay
# cannot read config.yaml and the install fails polling /health/instance.
# Check against your image if Quay's packaging ever changes:
#   podman inspect --format '{{.Config.User}}' <quay image>
QUAY_CONTAINER_UID="1001"

# TLS for the registry. Leave BOTH empty to keep the default behaviour:
# mirror-registry generates a self-signed CA and everything downstream uses
# it. Set BOTH to serve a certificate you issued yourself.
#
# Use this when the environment already has a CA -- then the registry, the
# cluster and anything else share one root instead of the cluster being
# asked to trust a CA that signed exactly one certificate.
#
# The certificate MUST carry REGISTRY_HOST as a SAN. mirror-registry does
# not check, and a mismatch surfaces much later as an image pull failure
# during bootstrap that says nothing about names.
#
#   REGISTRY_TLS_CERT="${OCP_AIRGAP_ROOT}/certs/registry.crt"
#   REGISTRY_TLS_KEY="${OCP_AIRGAP_ROOT}/certs/registry.key"
REGISTRY_TLS_CERT=""
REGISTRY_TLS_KEY=""

# The CA that signs the registry certificate. This is what goes into the
# host trust store, the handoff bundle and additionalTrustBundle.
#
# Leave empty and it defaults to the self-signed CA mirror-registry
# generates at ${QUAY_ROOT}/quay-rootCA/rootCA.pem. When bringing your own
# certificate, set this to the issuing CA -- otherwise the cluster is handed
# a CA that did not sign what the registry is actually serving.
#
#   REGISTRY_CA_PEM="${OCP_AIRGAP_ROOT}/certs/root-ca.pem"
REGISTRY_CA_PEM=""

# Initial Quay credentials created by `mirror-registry install`.
# Change QUAY_PASSWORD before running, and rotate after the evaluation.
QUAY_USER="init"
QUAY_PASSWORD="CHANGE-ME-before-running"

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------

# Red Hat pull secret, from
#   https://console.redhat.com/openshift/downloads#tool-pull-secret
# Used on the CONNECTED bastion only.
RH_PULL_SECRET="${OCP_AIRGAP_ROOT}/binaries/pull-secret.json"

# Generated auth file for the local Quay. Used on the REGISTRY HOST.
# Created by scripts/50-install-registry.sh.
MIRROR_PULL_SECRET="${OCP_AIRGAP_ROOT}/binaries/mirror-pull-secret.json"

# ---------------------------------------------------------------------------
# Tunables
# ---------------------------------------------------------------------------

# Split archives at this size in GB, to fit your transport medium.
# The authoritative setting is `archiveSize` in the ImageSetConfiguration;
# this variable is informational only.
ARCHIVE_SIZE_GB="100"

# oc-mirror runs a local storage instance on this port. If it is occupied or
# blocked by firewalld, mirroring fails. See docs/appendix-fips-stig.md.
OC_MIRROR_PORT="55000"

# Exported as TMPDIR by the mirror and push scripts. oc-mirror stages
# temporary image blobs here and unpacks a helper binary it then executes.
# Unset, this defaults to /var/tmp, which STIG requires to be a separate
# file system (V-257848) and the SSG kickstart sizes at 5 GB -- one large
# layer overruns it. CACHE_DIR does NOT cover this.
#
# The target must be exec-capable and fapolicyd-allowed, or the push fails
# on exec instead of on space. Leave empty to use the system default.
# See docs/appendix-fips-stig.md.
MIRROR_TMPDIR=""

# Parallelism. Lower these if the connected bastion is bandwidth-limited or
# the upstream registry is throttling. Max 10 each.
# Measured against a 2 vCPU registry host, 203 images, 29 GB:
#
#   4 / 5   21m    405 token failures on every one of four pushes, each
#                  needing a manual retry
#   1 / 1   22m53s zero 405s, clean on the first attempt
#
# Eight percent slower for a push that actually finishes. Raise these only
# if you have a larger registry host and have confirmed a clean first push
# at the higher value -- see docs/06-push-to-registry.md.
PARALLEL_IMAGES="1"
PARALLEL_LAYERS="1"

# Set to "true" for registries that restrict repository path depth
# (common with Artifactory/Harbor). See docs/appendix-byo-registry.md.
USE_MAX_NESTED_PATHS="false"
MAX_NESTED_PATHS="2"

# Minimum free space, in GB, that scripts/00-preflight.sh insists on before
# letting a run start.
#
# These are FLOORS that catch an undersized host -- they are not the
# recommended size. The recommendation is 500 GB on the registry host; see
# docs/10-capacity-planning.md.
#
# Do not set a floor to the provisioned size. `df` reports ~465-497 GiB
# available on a nominal "500 GB" volume, so a 500 floor rejects exactly
# the disk you were told to buy.
#
# For reference, a measured platform + 2 operators mirror consumed 25 GiB
# of cache and a 29 GiB archive, so these leave generous room to grow.
MIN_CACHE_GB="150"      # connected: layer cache
MIN_OUTPUT_GB="150"     # connected: archive output
MIN_QUAY_GB="200"       # registry host: podman storage root (actual images)
MIN_QUAYROOT_GB="1"     # registry host: quayRoot (config + certs only)
MIN_IMPORT_GB="100"     # registry host: transferred archives
MIN_TMP_GB="20"         # both: TMPDIR, which stages blobs in flight

# Fail the mirror rather than emit an archive segment larger than
# archiveSize. Use when the transport medium has a hard limit.
STRICT_ARCHIVE="false"
